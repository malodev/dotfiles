{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.media"
        },
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.active-window"
        },
        {
          "id": "omaplug",
          "autoCheckUpdates": true
        }
      ],
      "center": [
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "dddd dd/MM/yyyy",
          "verticalFormat": "HH\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "voxtype-mode",
          "type": "command",
          "exec": "$HOME/.local/bin/voxtype-mode-status",
          "interval": 2,
          "onClick": "$HOME/.local/bin/voxtype-mode-toggle"
        }
      ],
      "right": [
        {
          "id": "quickshell.spotify"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "akshar.radio-atlas"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "bottom",
    "transparent": false
  },
  "idle": {
    "lock": 2147483,
    "screensaver": 300
  },
  "plugins": [
    {
      "id": "expose.window-overview"
    },
    {
      "id": "io.github.mtolhuys.theme-manager"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.image-picker"
  ],
  "cloneSourceRestores": [
    "io.github.mtolhuys.theme-manager"
  ]
}
