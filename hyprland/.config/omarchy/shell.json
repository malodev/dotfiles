{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.media"
        },
        {
          "id": "quickshell.spotify"
        },
        {
          "id": "omarchy.active-window"
        },
        {
          "id": "mauro.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "dddd dd/MM/yyyy",
          "verticalFormat": "HH\nmm",
          "weekStartDay": "sunday"
        },
        {
          "id": "omarchy.elsewhen",
          "zones": "Rome|Europe/Rome, Delhi|Asia/Kolkata, Tokyo|Asia/Tokyo, Los Angeles|America/Los_Angeles, New York|America/New_York"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omaplug",
          "autoCheckUpdates": true
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.agents",
          "settings": {
            "refreshIntervalSec": 300
          }
        },
        {
          "id": "voxtype-mode",
          "type": "command",
          "exec": "$HOME/.local/bin/voxtype-mode-status",
          "interval": 2,
          "onClick": "$HOME/.local/bin/voxtype-mode-toggle"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "mauro.rt100",
          "label": "metrics"
        },
        {
          "id": "abduldotdev.camera"
        },
        {
          "id": "omakdeconnect",
          "preferredDeviceId": "6aa1023e_93c9_486b_b1f0_8e10d8907dac"
        },
        {
          "id": "akshar.radio-atlas"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "bottom",
    "transparent": false
  },
  "idle": {
    "lock": 2147483,
    "screensaver": 300
  },
  "plugins": [
    {
      "id": "expose.window-overview"
    },
    {
      "id": "io.github.mtolhuys.theme-manager"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.image-picker"
  ],
  "cloneSourceRestores": [
    "io.github.mtolhuys.theme-manager"
  ]
}
