{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.media"
        },
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "center": [
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.clock",
          "format": "hh:mm AP",
          "formatAlt": "dddd dd/MM/yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "voxtype-mode",
          "type": "command",
          "exec": "$HOME/.local/bin/voxtype-mode-status",
          "interval": 2,
          "onClick": "$HOME/.local/bin/voxtype-mode-toggle"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "bottom",
    "transparent": false
  },
  "idle": {
    "lock": 2147483,
    "screensaver": 300
  },
  "plugins": [
    {
      "id": "expose.window-overview"
    }
  ],
  "version": 1
}
