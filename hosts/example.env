# Host profile for `dot deploy --profile <name>`.
#
# Copy this to hosts/<machine>.env (tracked, when the target is a shared one such as a test
# VM) or to hosts/<machine>.local.env (untracked, for a real machine of yours) and fill in
# what that machine should end up with. It is a plain shell fragment: the `dot` CLI sources
# it, so there is no parser involved and no new dependency.
#
#   dot deploy --profile school-laptop --dry-run
#   dot deploy --profile school-laptop

# Where the machine is. HOST is required (the example leaves it empty on purpose, so that
# copying this file cannot deploy somewhere by accident); USER is optional and HOST may
# itself be "user@host".
HOST=
USER=
SSH_PORT=22

# How the repository gets there:
#   tar    nothing needed on the target, no history (default)
#   clone  needs GitHub reachable from the target, keeps history
TRANSPORT=tar

# Stage 0 scope. 1 adds nvim-malo, zig and the optional pi extension set.
FULL=0

# System layer, run after Stage 0. Empty means userspace only, which is the default and the
# only thing a machine without sudo can do. The installer takes a preset (--minimal, --ssh,
# --standard, --full) or explicit groups (-g editor -g desktop); it needs sudo on the target.
INSTALL_GROUPS=

# Repository path on the target. Keep the tilde quoted: this file is sourced on the machine
# you deploy *from*, so an unquoted ~ would expand to that machine's home directory.
DIR='~/dotfiles'
