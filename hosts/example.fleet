# Fleet file for `dot deploy --hosts <file>`: one target per line.
#
# A line is either
#   * a profile name      -> hosts/<name>.env, or hosts/<name>.local.env when present
#   * an ssh destination  -> user@host, used when no such profile exists
# optionally followed by per-host overrides:
#   transport=tar|clone   port=N   dir=PATH   full=0|1   groups="…"   verify_only=0|1
#
# Blank lines, and everything after a #, are ignored. A target that is neither a known
# profile nor a destination is reported and skipped; the run keeps going either way.

# Lab VMs (see DEPLOYMENT.md S1/S3/S4)
debian-vm
mauro@192.168.6.30

# Windows goes through the same transport: the archive is extracted with tar.exe (Windows 10
# 1803+) or 7z.exe on the target, and Stage 0 runs the policy-proof way.
mauro@192.168.6.33 port=2222

# A school laptop: userspace only, no system layer, and the shell is what needs fixing
# school-laptop full=0 groups=
