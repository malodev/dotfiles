{
  "version": 1,
  "providers": {
    "pi-llama": {
      "name": "Pi llama.cpp router",
      "baseUrl": "https://llm.malo.tn.it/v1",
      "api": "openai-completions",
      "apiKey": "!~/.local/bin/pi-inference credential model-api",
      "authHeader": true,
      "compat": {
        "supportsStore": false,
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false,
        "supportsUsageInStreaming": true,
        "maxTokensField": "max_tokens",
        "supportsStrictMode": false,
        "requiresReasoningContentOnAssistantMessages": true,
        "thinkingFormat": "qwen-chat-template"
      }
    }
  },
  "roles": {
    "architect": {
      "provider": "pi-llama",
      "model": "pi/Qwen3.8-27B-UD-Q5_K_XL",
      "name": "Qwen3.8 27B UD Q5 K XL",
      "reasoning": true,
      "input": [
        "text",
        "image"
      ],
      "contextWindow": 262144,
      "maxTokens": 258048,
      "thinking": "high"
    },
    "builder": {
      "provider": "pi-llama",
      "model": "pi/Qwen3.8-27B-UD-Q5_K_XL",
      "name": "Qwen3.8 27B UD Q5 K XL",
      "reasoning": true,
      "input": [
        "text",
        "image"
      ],
      "contextWindow": 262144,
      "maxTokens": 258048,
      "thinking": "high"
    },
    "reviewer": {
      "provider": "pi-llama",
      "model": "pi/Muse-Glimmer-30B-UD-Q5_K_XL",
      "name": "Muse Glimmer 30B UD Q5 K XL",
      "reasoning": true,
      "input": [
        "text",
        "image"
      ],
      "contextWindow": 131072,
      "maxTokens": 126976,
      "thinking": "high"
    }
  },
  "limits": {
    "builderAttempts": 16,
    "reviewerAttempts": 4,
    "roleTimeoutSeconds": 7200,
    "idleTimeoutSeconds": 300
  },
  "queue": {
    "leaseTtlSeconds": 120,
    "heartbeatIntervalSeconds": 30,
    "executionLockTimeoutSeconds": 30,
    "localExpiryMarginSeconds": 15
  },
  "lifecycle": {
    "managedProviders": [
      "pi-llama"
    ],
    "enterTeamCommand": "~/.local/bin/pi-inference team",
    "acquireTeamCommand": "~/.local/bin/pi-inference acquire --mode team",
    "renewTeamCommand": "~/.local/bin/pi-inference renew",
    "releaseTeamCommand": "~/.local/bin/pi-inference release",
    "leaseTtlSeconds": 300,
    "leaseRenewIntervalSeconds": 100,
    "restoreStudioAfterRun": false
  }
}
