[Unit]
Description=Pi inference ownership and lifecycle manager
Documentation=file:%h/.config/pi-inference/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/test -s %h/.pi-inference/credentials/control-api-token
ExecStartPre=/usr/bin/test -s %h/.pi-inference/credentials/model-api-key
ExecStart=%h/.local/bin/pi-inference-manager
Restart=on-failure
RestartSec=3
StateDirectory=pi-inference-manager
StateDirectoryMode=0700
RuntimeDirectory=pi-inference-manager
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectHome=read-only
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
