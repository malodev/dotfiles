[[ -f ~/.zshrc_malo ]] && source ~/.zshrc_malo
source ~/.fonts/*.sh
export POWERLEVEL9K_SHORTEN_DIR_LENGTH=1
export POWERLEVEL9K_SHORTEN_DELIMITER=""
export POWERLEVEL9K_SHORTEN_STRATEGY="truncate_from_right"
export POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(context public_ip dir rbenv vcs)
export POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(status root_indicator background_jobs load time)

if [[ `uname` == 'Darwin' ]]
then
        export OSX=1
else
        export OSX=
fi

alias passwd_gen='LC_ALL=C tr -dc "[:alpha:][:alnum:]" < /dev/urandom | head -c 20 | pbcopy'
[[ "$OSX" == "1" ]] && alias updatedb='sudo launchctl load -w /System/Library/LaunchDaemons/com.apple.locate.plist'

gitlab_group_members_id() { [[ $1 != "" ]] && gitlab group_members $1|awk -F "|" '{print $5}'|grep -E '\d+' }
gitlab_users() {
        tmpfile=$(mktemp /tmp/gitlab_users.XXXXXX)
        exec 3>"$tmpfile"
        exec 4<"$tmpfile"
        rm "$tmpfile"
    gitlab users "{per_page: 100, page: 1}"|grep -E 'active' >& 3
    gitlab users "{per_page: 100, page: 2}"|grep -E 'active' >& 3

        if [[ $1 != "" ]]; then
                cat <& 4 >$1
    else
                cat <& 4
    fi
}
gitlab_users_match() {
        if [[ $1 != "" ]]; then
                awk -F '|' 'NR==FNR {seen[$1]=1; next} gsub(/ /, "", $10) && $10!="" && seen[$10]==1 { print $12}' $1 <(gitlab_users)
        fi
}
