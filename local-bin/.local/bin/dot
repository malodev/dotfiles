#!/usr/bin/env bash
#=============================================================================
# dot — Universal Agent-Managed Dotfiles CLI
#
# Entrypoint for inspecting, bootstrapping, linking, validating, and invoking
# an LLM coding agent on your dotfiles repository across macOS, Linux, and WSL.
# (Native Windows uses scripts/windows/dot.ps1 via PowerShell profile).
#=============================================================================
set -eo pipefail

resolve_repo() {
  if [[ -n "${DOTFILES_REPO:-}" && -d "${DOTFILES_REPO}" ]]; then
    echo "$DOTFILES_REPO"
    return
  fi
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  local bin_dir
  bin_dir="$(cd -P "$(dirname "$src")" && pwd)"
  # bin_dir is <repo>/local-bin/.local/bin
  if [[ -f "$bin_dir/../../../install.sh" ]]; then
    cd -P "$bin_dir/../../.." && pwd
    return
  fi
  if [[ -d "$HOME/dotfiles" ]]; then
    echo "$HOME/dotfiles"
    return
  fi
  if [[ -d "$HOME/.dotfiles" ]]; then
    echo "$HOME/.dotfiles"
    return
  fi
  echo "error: could not locate dotfiles repository" >&2
  exit 1
}

REPO="$(resolve_repo)"
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$HOME/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

usage() {
  cat <<EOF
dot — Agent-Managed Dotfiles CLI ($REPO)

Usage:
  dot doctor [--json]           Inspect OS capabilities, toolchain, symlinks, and drift
  dot doctor --host <h>         Same sensor on another machine, over SSH (--ssh-port, --dir, --json)
  dot bootstrap [--full]        Run Stage 0 seed (essential pi + nvim-lite by default; --full for all)
  dot link [--full] [args...]   Sync agent skills & seed pi templates (--full includes optional extensions)
  dot deploy [--to HOST]        Push the repository to a target over SSH, seed it, verify it
                                (--profile <name> reads hosts/<name>.env; --dry-run, --verify-only)
  dot nvim [lite|malo|status]   Show or switch the default Neovim configuration (lite vs malo)
  dot prompt [starship|parrot]  Show or switch the Bash prompt theme (default: starship)
  dot overrides [args...]       Inspect or extract machine-local overrides (--apply, --dry-run)
  dot install [args...]         Run the modular installer (./install.sh)
  dot validate                  Run installer and manifest validation suite
  dot status                    Run git status in the dotfiles repository
  dot cd                        Print repository path
  dot agent [prompt...]         Launch an AI coding agent (pi/claude/agy) in the repo with doctor context
  dot <prompt...>               Shorthand for 'dot agent <prompt...>'
EOF
}

#-----------------------------------------------------------------------------
# Remote sensor: the target's own `dot doctor`, summarised. Shared by `dot deploy`
# and `dot doctor --host`.
#-----------------------------------------------------------------------------
# Remote sensor: the target's own `dot doctor`, summarised. Shared by `dot deploy`
# and `dot doctor --host`. Also leaves the JSON in REMOTE_DOCTOR_JSON.
#-----------------------------------------------------------------------------
remote_doctor() {
  local host="$1" port="$2" dir="$3"; shift 3
  local json=0 a
  for a in "$@"; do [[ "$a" == "--json" ]] && json=1; done

  local -a ssh_cmd=(ssh -o BatchMode=yes -o ConnectTimeout=15)
  [[ "$port" != "22" ]] && ssh_cmd+=(-p "$port")

  # `uname` answers on Unix and fails on Windows, where the default shell is PowerShell;
  # a failing probe must not abort the caller (set -e plus pipefail would).
  local platform="unix" os
  os="$("${ssh_cmd[@]}" "$host" 'uname -s 2>/dev/null' 2>/dev/null | tr -d '\r' || true)"
  case "$os" in
    Linux|Darwin|FreeBSD|OpenBSD|NetBSD) ;;
    *) if "${ssh_cmd[@]}" "$host" 'powershell -NoLogo -NoProfile -Command exit 0' >/dev/null 2>&1; then
         platform="windows"
       else
         echo "  [!] uname said '$os' and PowerShell is not there either; assuming unix" >&2
       fi ;;
  esac

  local doctor_json=""
  if [[ "$platform" == "windows" ]]; then
    # `dot` comes from the profile, which loads for SSH sessions on a healthy machine.
    doctor_json="$("${ssh_cmd[@]}" "$host" 'dot doctor -Json' 2>/dev/null || true)"
  else
    # Prefer the linked CLI, fall back to the copy in the repository.
    doctor_json="$("${ssh_cmd[@]}" "$host" \
      "if [ -x \"\$HOME/.local/bin/dot\" ]; then \"\$HOME/.local/bin/dot\" doctor --json; else cd $dir && ./local-bin/.local/bin/dot doctor --json; fi" \
      2>/dev/null || true)"
  fi
  # A PowerShell host can print a profile warning before the JSON; everything up to the
  # opening brace is noise.
  doctor_json="$(printf '%s\n' "$doctor_json" | sed -n '/^{/,$p')"

  if [[ -z "$doctor_json" ]]; then
    echo "  [!] $host did not answer with doctor JSON (is the repository there and dot linked?)" >&2
    return 1
  fi
  REMOTE_DOCTOR_JSON="$doctor_json"

  if [[ "$json" == "1" ]]; then
    printf '%s\n' "$doctor_json"
    return 0
  fi
  if command -v jq >/dev/null 2>&1; then
    printf '%s\n' "$doctor_json" | jq -r '
      "  platform:  " + (.platform.os // "?") + " / " + (.platform.distro // "?") + " (" + (.platform.recommended_profile // "?") + ")",
      "  tools:     missing: " + (([.tools | to_entries[] | select(.value == false) | .key] | join(", ")) // "none"),
      "  agents:    pi: " + ((.agents.pi // "absent") | tostring),
      "  providers: ready: " + (if .providers.ready == null then "?" else (.providers.ready | tostring) end),
      "  profile:   can_load: " + (if .execution_policy.profile_can_load == null then "?" else (.execution_policy.profile_can_load | tostring) end),
      "  drift:     " + ((.drift.git_branch // "?") | tostring) + " dirty: " + ((.drift.git_dirty_files // 0) | tostring)'
  else
    printf '%s\n' "$doctor_json"
  fi
  return 0
}

deploy_usage() {
  cat <<EOF
dot deploy — push these dotfiles to one machine, or to a fleet, over SSH

Usage:
  dot deploy --to <host> [options]
  dot deploy --profile <name> [options]
  dot deploy --hosts <file> [options]

Options:
  --to HOST          ssh destination, e.g. 192.168.6.30 or mauro@host
  --profile NAME     defaults from hosts/NAME.env (HOST, USER, SSH_PORT, TRANSPORT,
                     FULL, INSTALL_GROUPS, DIR)
  --hosts FILE       one target per line: a profile name, or an ssh destination, with
                     optional per-host overrides (transport=, port=, dir=, full=,
                     groups=, verify_only=). See hosts/example.fleet.
  --ssh-port N       ssh port (default 22)
  --transport MODE   tar (default, nothing needed on the target) | clone (GitHub on the target)
  --full             include the optional pi extension set / nvim-malo
  --groups "a b c"   system installer groups to run after Stage 0 (needs sudo on the target)
  --dir PATH         repository path on the target (default ~/dotfiles)
  --dry-run          print the commands instead of running them (the verification probe
                     still runs: it is read-only and shows the state before the change)
  --verify-only      skip transport and bootstrap, just inspect the target(s)
  --json             print each target's doctor JSON verbatim (no fleet table)
EOF
}

# A profile is a shell fragment. Declaring the names first keeps it from touching anything
# else, and every value is optional: whatever it does not set keeps the CLI default.
load_host_profile() {
  local name="$1" pf
  pf="$REPO/hosts/$name.env"
  [[ -f "$pf" ]] || pf="$REPO/hosts/$name.local.env"
  [[ -f "$pf" ]] || return 1
  # GROUPS is a bash special variable and cannot be assigned, hence INSTALL_GROUPS.
  local HOST="" USER="" SSH_PORT="" TRANSPORT="" FULL="" INSTALL_GROUPS="" DIR=""
  # shellcheck disable=SC1090
  source "$pf"
  [[ -n "$HOST" ]] && dp_host="${USER:+$USER@}$HOST"
  [[ -n "$SSH_PORT" ]] && dp_port="$SSH_PORT"
  [[ -n "$TRANSPORT" ]] && dp_transport="$TRANSPORT"
  [[ "${FULL:-0}" == "1" ]] && dp_full="1"
  [[ -n "$INSTALL_GROUPS" ]] && dp_groups="$INSTALL_GROUPS"
  [[ -n "$DIR" ]] && dp_dir="$DIR"
  return 0
}

# One target; every setting is already in dp_*.
deploy_one() {
  local -a ssh_cmd=(ssh -o BatchMode=yes -o ConnectTimeout=15)
  [[ "$dp_port" != "22" ]] && ssh_cmd+=(-p "$dp_port")
  local failed=0

  run_remote() {
    if [[ "$dp_dry" == "1" ]]; then
      printf '  [dry-run] ssh %s: %s\n' "$dp_host" "$1"
    elif ! "${ssh_cmd[@]}" "$dp_host" "$1"; then
      # Keep going: the verification step below is what tells the caller where it ended up.
      echo "  [!] remote command failed" >&2
      failed=1
    fi
  }

  echo "── dot deploy → $dp_host ──" >&2

  # 1. What is on the other side?
  local platform="unix" os
  os="$("${ssh_cmd[@]}" "$dp_host" 'uname -s 2>/dev/null' 2>/dev/null | tr -d '\r' || true)"
  case "$os" in
    Linux|Darwin|FreeBSD|OpenBSD|NetBSD) echo "  target:   $os" >&2 ;;
    *) if "${ssh_cmd[@]}" "$dp_host" 'powershell -NoLogo -NoProfile -Command exit 0' >/dev/null 2>&1; then
         platform="windows"; echo "  target:   Windows" >&2
       else
         echo "  [!] uname said '$os' and PowerShell is not there either; assuming unix" >&2
       fi ;;
  esac
  echo "  platform: $platform" >&2
  [[ -n "$dp_groups" ]] && echo "  groups:   $dp_groups (system layer)" >&2

  if [[ "$dp_verify_only" != "1" ]]; then
    # 2. Transport
    case "$dp_transport" in
      tar)
        if [[ "$platform" == "windows" ]]; then
          echo "  [!] tar transport is not implemented for Windows: use transport=clone" >&2
          failed=1
        else
          echo "  transport: tar (no git needed on the target)" >&2
          if [[ "$dp_dry" == "1" ]]; then
            printf '  [dry-run] COPYFILE_DISABLE=1 tar -czf - --exclude=.git --exclude=pi/mattpocock-skills . | ssh %s "mkdir -p %s && tar -xzf - -C %s"\n' "$dp_host" "$dp_dir" "$dp_dir"
          else
            # COPYFILE_DISABLE keeps macOS tar from shipping AppleDouble ._* files, which
            # otherwise land in the target as thousands of junk files.
            if ! COPYFILE_DISABLE=1 tar -czf - --exclude=.git --exclude=pi/mattpocock-skills . \
                 | "${ssh_cmd[@]}" "$dp_host" "mkdir -p $dp_dir && tar -xzf - -C $dp_dir"; then
              echo "  [!] tar transport failed" >&2
              failed=1
            fi
          fi
        fi
        ;;
      clone)
        echo "  transport: clone (needs GitHub on the target)" >&2
        run_remote "if [ -d $dp_dir/.git ]; then git -C $dp_dir pull --ff-only; else git clone https://github.com/malodev/dotfiles.git $dp_dir; fi"
        ;;
      *) echo "dot deploy: unknown transport '$dp_transport' (tar|clone)" >&2; return 1 ;;
    esac

    # 3. Stage 0
    echo "  bootstrap:" >&2
    local flags=""
    [[ "$dp_full" == "1" ]] && flags="--full"
    if [[ "$platform" == "windows" ]]; then
      deploy_windows_bootstrap '$env:USERPROFILE\dotfiles' "$flags"
    else
      run_remote "cd $dp_dir && bash ./bootstrap.sh $flags"
    fi

    # 4. Optional system layer
    if [[ -n "$dp_groups" ]]; then
      echo "  system layer:" >&2
      # Not `sudo ./install.sh`: the installer escalates by itself where it needs to, and
      # running the whole thing as root would stow into root's $HOME instead of the user's.
      run_remote "cd $dp_dir && ./install.sh $dp_groups"
    fi
  fi

  # 5. Verify
  echo "  verify:" >&2
  local -a json_flag=()
  [[ "$dp_json" == "1" ]] && json_flag=(--json)
  remote_doctor "$dp_host" "$dp_port" "$dp_dir" "${json_flag[@]}" || failed=1

  if [[ "$failed" != "0" ]]; then
    echo "  [!] something on $dp_host failed: see the messages above" >&2
  fi
  return "$failed"
}

deploy() {
  # Defaults. The fleet loop resets every one of these before each host.
  dp_host=""; dp_port="22"; dp_transport="tar"; dp_full="0"; dp_groups=""; dp_dir='~/dotfiles'
  dp_dry="0"; dp_verify_only="0"; dp_json="0"; dp_profile=""; dp_hosts_file=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --to)          dp_host="$2"; shift 2 ;;
      --profile)     dp_profile="$2"; shift 2 ;;
      --hosts)       dp_hosts_file="$2"; shift 2 ;;
      --ssh-port)    dp_port="$2"; shift 2 ;;
      --transport)   dp_transport="$2"; shift 2 ;;
      --full)        dp_full="1"; shift ;;
      --groups)      dp_groups="$2"; shift 2 ;;
      --dir)         dp_dir="$2"; shift 2 ;;
      --dry-run)     dp_dry="1"; shift ;;
      --verify-only) dp_verify_only="1"; shift ;;
      --json)        dp_json="1"; shift ;;
      -h|--help)     deploy_usage; return 0 ;;
      *) echo "dot deploy: unknown option: $1" >&2; deploy_usage >&2; return 1 ;;
    esac
  done

  if [[ -n "$dp_profile" ]]; then
    load_host_profile "$dp_profile" || { echo "dot deploy: no such profile: hosts/$dp_profile.env" >&2; return 1; }
    [[ -n "$dp_host" ]] || { echo "dot deploy: profile hosts/$dp_profile.env has no HOST; set it there or pass --to" >&2; return 1; }
  fi

  # One target
  if [[ -z "$dp_hosts_file" ]]; then
    [[ -n "$dp_host" ]] || { echo "dot deploy: --to <host>, --profile <name> or --hosts <file> is required" >&2; deploy_usage >&2; return 1; }
    deploy_one
    return $?
  fi

  # A fleet: one target per line, grouped by profile
  [[ -f "$dp_hosts_file" ]] || { echo "dot deploy: no such fleet file: $dp_hosts_file" >&2; return 1; }

  local base_host="$dp_host" base_port="$dp_port" base_transport="$dp_transport"
  local base_full="$dp_full" base_groups="$dp_groups" base_dir="$dp_dir"
  local base_verify_only="$dp_verify_only"
  local line entry kv row r shown_host fleet_failed=0
  local -a rows=()
  local -a fleet_lines=()

  # Read the whole file first: the ssh calls inside the loop would otherwise consume the
  # remaining lines from stdin and the fleet would stop after the first host.
  while IFS= read -r line || [[ -n "$line" ]]; do
    fleet_lines+=("$line")
  done < "$dp_hosts_file"

  for line in "${fleet_lines[@]}"; do
    line="${line%%#*}"
    # Intentional word splitting: the line is "<target> [key=value ...]".
    # shellcheck disable=SC2086
    set -- $line
    [[ $# -gt 0 ]] || continue
    entry="$1"; shift

    dp_host="$base_host"; dp_port="$base_port"; dp_transport="$base_transport"
    dp_full="$base_full"; dp_groups="$base_groups"; dp_dir="$base_dir"
    dp_verify_only="$base_verify_only"
    # A profile name, or an ssh destination when no such profile exists.
    load_host_profile "$entry" || dp_host="$entry"

    for kv in "$@"; do
      case "$kv" in
        transport=*)   dp_transport="${kv#*=}" ;;
        port=*)        dp_port="${kv#*=}" ;;
        dir=*)         dp_dir="${kv#*=}" ;;
        full=*)        dp_full="${kv#*=}" ;;
        groups=*)      dp_groups="${kv#*=}" ;;
        verify_only=*) dp_verify_only="${kv#*=}" ;;
        *) echo "  [!] unknown fleet option: $kv" >&2 ;;
      esac
    done

    if [[ -z "$dp_host" ]]; then
      echo "  [!] '$entry' is neither a profile nor a destination; skipping" >&2
      fleet_failed=1
      continue
    fi

    echo ""
    REMOTE_DOCTOR_JSON=""
    if deploy_one; then row="ok"; else row="failed"; fleet_failed=1; fi

    if [[ -n "$REMOTE_DOCTOR_JSON" ]] && command -v jq >/dev/null 2>&1; then
      shown_host="$dp_host"
      [[ "$dp_port" != "22" ]] && shown_host="$dp_host:$dp_port"
      rows+=("$(printf '%s\n' "$REMOTE_DOCTOR_JSON" | jq -r --arg h "$shown_host" --arg r "$row" \
        '[$h, (.platform.os // "?") + "/" + (.platform.distro // "?"), $r,
          (if .providers.ready == null then "?" else (.providers.ready | tostring) end),
          ((.drift.git_dirty_files // 0) | tostring)] | @tsv')")
    else
      shown_host="$dp_host"
      [[ "$dp_port" != "22" ]] && shown_host="$dp_host:$dp_port"
      rows+=("$(printf '%s\t%s\t%s\t%s\t%s' "$shown_host" "?" "$row" "?" "?")")
    fi
  done

  if [[ "$dp_json" != "1" ]]; then
    echo ""
    echo "── fleet summary ──"
    printf '  %-24s %-18s %-7s %-10s %s\n' "host" "platform" "result" "providers" "dirty"
    for r in "${rows[@]}"; do
      # shellcheck disable=SC2086
      printf '  %-24s %-18s %-7s %-10s %s\n' $r
    done
  fi

  if [[ "$fleet_failed" != "0" ]]; then
    echo ""
    echo "  [!] at least one host failed" >&2
  fi
  return "$fleet_failed"
}

cmd="${1:-doctor}"
shift || true

case "$cmd" in
  doctor)
    d_host=""; d_port="22"; d_dir='~/dotfiles'; d_pass=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --host)     d_host="$2"; shift 2 ;;
        --ssh-port) d_port="$2"; shift 2 ;;
        --dir)      d_dir="$2"; shift 2 ;;
        *)          d_pass+=("$1"); shift ;;
      esac
    done
    if [[ -z "$d_host" ]]; then
      exec "$REPO/scripts/doctor.sh" "${d_pass[@]}"
    fi
    # Keep stdout clean when the caller asked for JSON.
    [[ " ${d_pass[*]} " == *" --json "* ]] || echo "── dot doctor → $d_host ──"
    remote_doctor "$d_host" "$d_port" "$d_dir" "${d_pass[@]}"
    ;;
  bootstrap)
    exec "$REPO/bootstrap.sh" "$@"
    ;;
  link|sync)
    "$REPO/scripts/init-pi-settings.sh" "$@"
    "$REPO/scripts/link-pi-agent-entries.sh" "$@"
    ;;
  nvim)
    sub="${1:-status}"
    mkdir -p "$HOME/.config"
    ln -sfn "$REPO/nvim-lite/.config/nvim-lite" "$HOME/.config/nvim-lite"
    ln -sfn "$REPO/nvim-malo/.config/nvim-malo" "$HOME/.config/nvim-malo"
    case "$sub" in
      lite|minimal|bootstrap)
        ln -sfn "$REPO/nvim-lite/.config/nvim-lite" "$HOME/.config/nvim"
        echo "✓ Default Neovim config set to 'nvim-lite' (~/.config/nvim -> nvim-lite)."
        ;;
      malo|full|daily)
        ln -sfn "$REPO/nvim-malo/.config/nvim-malo" "$HOME/.config/nvim"
        echo "✓ Default Neovim config set to 'nvim-malo' (~/.config/nvim -> nvim-malo)."
        ;;
      status|"")
        target="$(readlink "$HOME/.config/nvim" 2>/dev/null || echo "unlinked")"
        echo "Current ~/.config/nvim -> $target (options: 'dot nvim lite' or 'dot nvim malo')"
        ;;
      *)
        echo "Usage: dot nvim [lite|malo|status]" >&2
        exit 1
        ;;
    esac
    ;;
  prompt)
    sub="${1:-status}"
    mkdir -p "$HOME/.config"
    case "$sub" in
      parrot)
        echo "parrot" > "$HOME/.config/dotfiles-bash-prompt"
        echo "✓ Bash prompt set to 'parrot' (~/.config/dotfiles-bash-prompt). Run 'source ~/.bashrc' in bash."
        ;;
      starship|default)
        echo "starship" > "$HOME/.config/dotfiles-bash-prompt"
        echo "✓ Bash prompt set to 'starship' (~/.config/dotfiles-bash-prompt). Run 'source ~/.bashrc' in bash."
        ;;
      status|"")
        current="starship"
        [[ -f "$HOME/.config/dotfiles-bash-prompt" ]] && current="$(tr -d '[:space:]' < "$HOME/.config/dotfiles-bash-prompt")"
        [[ -n "${DOTFILES_BASH_PROMPT:-}" ]] && current="$DOTFILES_BASH_PROMPT (via env)"
        echo "Current Bash prompt: $current (options: starship, parrot)"
        ;;
      *)
        echo "Usage: dot prompt [starship|parrot|status]" >&2
        exit 1
        ;;
    esac
    ;;
  overrides)
    exec "$REPO/scripts/extract-local-overrides.sh" "$@"
    ;;
  install)
    exec "$REPO/install.sh" "$@"
    ;;
  validate|test)
    exec "$REPO/scripts/validate-install.sh" "$@"
    ;;
  status|st)
    if [[ -d "$REPO/.git" || -f "$REPO/.git" ]]; then
      exec git -C "$REPO" status "$@"
    else
      echo "⚠ $REPO was synced without .git metadata (tarball/sandbox mode)."
      exec "$REPO/scripts/doctor.sh"
    fi
    ;;
  cd|path)
    echo "$REPO"
    ;;
  --help|-h|help)
    usage
    ;;
  agent)
    cd "$REPO"
    DOCTOR_JSON="$("$REPO/scripts/doctor.sh" --json 2>/dev/null || true)"
    USER_PROMPT="$*"
    if printf '%s' "$DOCTOR_JSON" | grep -q '"ready": false'; then
      echo "note: no pi provider key resolves on this host (see 'dot doctor'), so the" >&2
      echo "      first prompt will fail auth. Add the key file a provider expects in" >&2
      echo "      ~/.pi/agent/models.json, or run 'pi auth' for a subscription provider." >&2
    fi
    if command -v pi >/dev/null 2>&1; then
      if [[ -n "$USER_PROMPT" ]]; then
        exec pi "Current machine state from 'dot doctor --json': $DOCTOR_JSON. Task: $USER_PROMPT"
      else
        exec pi
      fi
    elif command -v claude >/dev/null 2>&1; then
      if [[ -n "$USER_PROMPT" ]]; then
        exec claude "Current machine state from 'dot doctor --json': $DOCTOR_JSON. Task: $USER_PROMPT"
      else
        exec claude
      fi
    elif command -v agy >/dev/null 2>&1; then
      exec agy "$REPO"
    else
      echo "No agent CLI (pi, claude, agy) found on PATH. Run 'dot bootstrap' first." >&2
      exit 1
    fi
    ;;
  deploy)
    deploy "$@"
    ;;
  *)
    # Treat unknown subcommands as natural-language prompts for the agent
    cd "$REPO"
    exec "$0" agent "$cmd" "$@"
    ;;
esac
