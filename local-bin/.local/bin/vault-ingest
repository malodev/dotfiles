#!/usr/bin/env bash
#
# File everything waiting to be ingested, and say what happened.
#
# Called from Obsidian's "File captured notes" command, and usable from a shell.
# Runs the vault ingestion for ReadItLater, then drains any inbox stubs, so one
# invocation clears both queues. A lock stops it overlapping a run started by the
# inbox path unit.
#
#   vault-ingest                 # the usual: ReadItLater, then the inbox
#   vault-ingest --dry-run       # show the plan, change nothing
#   vault-ingest --folder Life   # a different folder
#   vault-ingest --quiet         # print the log instead of notifying (Obsidian)
#
# Arguments other than --quiet are passed through to ingest.py.

set -uo pipefail

vault="${VAULT:-$HOME/Nextcloud/Obsidian/MalosVault}"
pipeline="$vault/Tools/vault-pipeline"
log="${XDG_RUNTIME_DIR:-/tmp}/vault-ingest.log"

quiet=""
args=()
for arg in "$@"; do
    if [ "$arg" = "--quiet" ]; then
        quiet="yes"
    else
        args+=("$arg")
    fi
done

{
    echo "=== $(date '+%Y-%m-%d %H:%M:%S') vault-ingest ${args[*]-} ==="
    "$pipeline/ingest.sh" ${args[@]+"${args[@]}"}
    status=$?
    if [ "$status" -eq 0 ]; then
        # Stubs captured on the phone, in case any are waiting.
        "$pipeline/inbox-drain.sh"
    fi
    echo "=== exit $status ==="
} >"$log" 2>&1

summary=$(grep -E 'ingested,|processed [0-9]+ of|inbox is empty' "$log" | tail -2 | tr '\n' ' ')
[ -n "$summary" ] || summary="nothing to do"

# Ask Obsidian to re-render its dataview lists rather than telling you to reload by hand.
# Dataview indexes metadata incrementally, so a batch of moves can leave its link graph
# partial. Its own "force refresh" command re-runs the views. This needs the Advanced URI
# plugin, and it is silently skipped when Obsidian is closed or the plugin is off.
refresh_obsidian() {
    [ -n "${XDG_RUNTIME_DIR:-}" ] || return 0
    pgrep -f '[o]bsidian' >/dev/null 2>&1 || return 0
    grep -q 'obsidian-advanced-uri' "$vault/.obsidian/community-plugins.json" 2>/dev/null || return 0
    command -v xdg-open >/dev/null 2>&1 || return 0
    xdg-open "obsidian://advanced-uri?vault=$(basename "$vault")&commandid=dataview-force-refresh-views" >/dev/null 2>&1 || true
    echo "asked Obsidian to refresh its dataview views" >> "$log"
}

moved=$(grep -oE '^[0-9]+ ingested,' "$log" | head -1 | grep -oE '[0-9]+')
if [ -n "$moved" ] && [ "$moved" -gt 0 ]; then
    refresh_obsidian
fi

if [ -n "$quiet" ]; then
    cat "$log"
    exit "$status"
fi

if command -v notify-send >/dev/null 2>&1; then
    if grep -qE 'FAILED|could not fetch' "$log"; then
        notify-send --app-name="Vault pipeline" --expire-time=10000 \
            "Vault ingest finished with errors" "$summary see $log"
    else
        notify-send --app-name="Vault pipeline" --expire-time=8000 \
            "Vault ingest finished" "$summary"
    fi
fi

tail -20 "$log"
