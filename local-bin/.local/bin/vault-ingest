#!/usr/bin/env bash
#
# File everything waiting to be ingested, and say what happened.
#
# Bound to SUPER + SHIFT + I. Runs the vault ingestion for ReadItLater, then drains
# any inbox stubs, so one keypress clears both queues. A lock stops it overlapping a
# run started by the inbox path unit.
#
#   vault-ingest                 # the usual: ReadItLater, then the inbox
#   vault-ingest --dry-run       # show the plan, change nothing
#   vault-ingest --folder Life   # a different folder
#
# Any argument is passed through to ingest.py.

set -uo pipefail

vault="${VAULT:-$HOME/Nextcloud/Obsidian/MalosVault}"
pipeline="$vault/Tools/vault-pipeline"

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send --app-name="Vault pipeline" --expire-time=8000 "$1" "$2" || true
}

log="${XDG_RUNTIME_DIR:-/tmp}/vault-ingest.log"
{
    echo "=== $(date '+%Y-%m-%d %H:%M:%S') vault-ingest $* ==="
    "$pipeline/ingest.sh" "$@"
    status=$?
    if [ "$status" -eq 0 ]; then
        # Stubs captured on the phone, in case any are waiting.
        "$pipeline/inbox-drain.sh"
    fi
    echo "=== exit $status ==="
} >"$log" 2>&1

summary=$(grep -E 'ingested,|processed [0-9]+ of' "$log" | tail -2 | tr '\n' ' ')
[ -n "$summary" ] || summary="nothing to do"

if grep -qE 'FAILED|could not fetch' "$log"; then
    notify "Vault ingest finished with errors" "$summary — see $log"
else
    notify "Vault ingest finished" "$summary"
fi

tail -20 "$log"
