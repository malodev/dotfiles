# Fonts
font-family = "Symbols Nerd Font Mono"
font-family = "JetBrainsMono NF Light"
font-family-bold = "JetBrainsMono NF Medium"
font-family-italic = "JetBrainsMono NF Light"
font-family-bold-italic = "JetBrainsMono NF Medium"
font-size = 28
adjust-underline-position = 4

# Mouse
mouse-hide-while-typing = true
# mouse-scroll-multiplier = 1

# Theme
theme = catppuccin-mocha
cursor-invert-fg-bg = true
background-opacity = 0.9
window-theme = ghostty

# keybindings
keybind = ctrl+a>comma=open_config
keybind = ctrl+a>shift+comma=reload_config

# Window
gtk-single-instance = true
gtk-tabs-location = bottom
gtk-wide-tabs = false
#
# Other
copy-on-select = clipboard
shell-integration = zsh
