# pi rewrites both of these itself (model picker, MCP server installs) and the
# content is per-host, so they are runtime state rather than configuration.
/pi/.pi/agent/models.json
/pi/.pi/agent/mcp.json

# pi also rewrites this (it records its own keybinding fields, e.g.
# deleteToLineStart) and that kept dirtying the tree. Shared defaults live in
# keybindings.json.template and are seeded by scripts/init-pi-settings.sh.
/pi/.pi/agent/keybindings.json
/pi/.pi/agent/skills/omarchy-app
/pi/.pi/agent/skills/omarchy
/pi/.pi/agent/skills/diagnose-crash
/pi/.pi/agent/extensions/mlxmon.ts
/pi/.pi/agent/extensions/vllm-mlx.ts

# pi-web-access writes its cache next to web-search.json, so every search
# dirties the working tree with files that are one machine's runtime state.
/pi/.config/pi/web-search-cache/

# Omarchy owns ~/.config/omarchy/shell.json. It rewrites it whenever the bar or
# a plugin changes (keeping its own shell.json.bak-* beside it), so the copy
# sitting here is a per-machine snapshot that only ever goes stale. Managed by
# the Omarchy system, not by the dotfiles.
/hyprland/.config/omarchy/shell.json
