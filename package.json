{
  "name": "dotfiles",
  "private": true,
  "description": "Multi-machine dotfiles managed with GNU Stow",
  "scripts": {
    "commitlint": "commitlint --edit",
    "test:pi-inference": "PYTHONPYCACHEPREFIX=/tmp/pi-inference-pycache python3 -m unittest discover -s tests/pi_inference -v",
    "test:three-agent-team:node": "npm --prefix pi/.pi/agent/extensions/three-agent-team run test:node",
    "test:three-agent-team:validator": "npm --prefix pi/.pi/agent/extensions/three-agent-team run test:validator",
    "test:three-agent-team": "npm run test:three-agent-team:node && npm run test:three-agent-team:validator && npm run test:pi-inference",
    "test:three-agent-team:production": "npm --prefix pi/.pi/agent/extensions/three-agent-team run test:production",
    "test:team-import-crash-matrix": "npm --prefix pi/.pi/agent/extensions/three-agent-team run test:crash-matrix",
    "test:team-import-clean-install": "npm --prefix pi/.pi/agent/extensions/three-agent-team run test:clean-install",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "yaml": "^2.5.0"
  }
}
